# Normalize line endings: LF in the repository and in the working tree on every OS
# (the project is edited on Windows and macOS, CI runs on Linux).
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.keystore binary
*.jks binary
*.so binary
*.mp3 binary
*.m4a binary
*.flac binary
*.opus binary
*.ogg binary
*.mka binary
