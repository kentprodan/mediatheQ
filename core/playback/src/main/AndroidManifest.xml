<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- ExoPlayer's network wake mode keeps streaming alive with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Bit-perfect USB sets the DAC's preferred mixer attributes (normal permission, granted at install). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application>
        <!-- Exported for system media controls (notification, lock screen, later Auto/Wear); onConnect filters callers. -->
        <service
            android:name=".MediatheqPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Play on headphones or a car kit with the app closed resumes the saved queue (#43). -->
        <receiver
            android:name=".MediatheqMediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
