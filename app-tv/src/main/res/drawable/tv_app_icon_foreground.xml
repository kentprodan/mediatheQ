<?xml version="1.0" encoding="utf-8"?>
<!--
  mediatheQ app icon (#264; a copy for the TV app, which never uses :core:designsystem, ADR 0038), foreground layer: a Q drawn as a record ring with three level bars inside, its tail a
  rounded play triangle. Everything, strokes included, stays inside the 66 dp safe zone (radius 33 around 54,54) of the 108 dp
  adaptive icon: the tail's tip reaches 30.3.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The ring. -->
    <path
        android:fillColor="#FFF5F0FF"
        android:fillType="evenOdd"
        android:pathData="M51,30a21,21 0,1 1,0 42a21,21 0,1 1,0 -42zM51,38.5a12.5,12.5 0,1 0,0 25a12.5,12.5 0,1 0,0 -25z" />
    <!-- Three level bars. -->
    <path
        android:pathData="M46,47.5L46,54.5M51,45L51,57M56,48.5L56,53.5"
        android:strokeWidth="3"
        android:strokeColor="#FFF5F0FF"
        android:strokeLineCap="round" />
    <!-- The tail: a play triangle with rounded corners, pointing out to the bottom right. -->
    <path
        android:fillColor="#FFFF8BC1"
        android:pathData="M57,70L70,57L74,74Z"
        android:strokeWidth="4"
        android:strokeColor="#FFFF8BC1"
        android:strokeLineJoin="round" />
</vector>
